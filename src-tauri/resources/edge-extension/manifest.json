{
  "manifest_version": 3,
  "key": "",
  "name": "Word文書一括作成ツール連携",
  "version": "3.0.0",
  "description": "行政文書管理システムから文書番号を取得し、Word文書一括作成ツールへ送信します。",
  "permissions": [
    "nativeMessaging",
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://gyobunkanri.lan.pref.osaka.jp/PanFocus/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gyobunkanri.lan.pref.osaka.jp/PanFocus/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}